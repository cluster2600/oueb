# Copiez vers .env (gitignoré) et remplissez. Générez les secrets avec `openssl rand -hex 32`.

# --- Global ---
MAIN_DOMAIN=oueb.example                 # domaine principal (console + réseau WP)
ACME_EMAIL=admin@oueb.example            # contact Let's Encrypt

# --- PostgreSQL (n8n + listmonk) ---
PG_USER=oueb
PG_PASSWORD=change-me-strong

# --- n8n ---
N8N_ENCRYPTION_KEY=change-me-32-bytes-hex

# --- WordPress ---
WP_DB_USER=wordpress
WP_DB_PASSWORD=change-me
WP_DB_ROOT_PASSWORD=change-me-root
OUEB_MULTISITE_READY=0                    # passe à 1 APRÈS scripts/bootstrap_wp.sh
WP_APP_USER=admin                         # Super Admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx  # mot de passe d'application WP

# --- Listmonk ---
LISTMONK_API_USER=oueb
LISTMONK_ADMIN_PASSWORD=change-me
LISTMONK_API_TOKEN=change-me              # token API (UI > Settings > API)

# --- Scraper ---
SCRAPER_TOKEN=change-me-hex

# --- Fournisseurs externes ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
CLOUDFLARE_API_TOKEN=...                  # achat/DNS domaines (ou Namecheap)

# --- Amazon SES (renseigné dans l'UI Listmonk, ici pour mémoire) ---
SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SES_SMTP_USER=...
SES_SMTP_PASSWORD=...
SES_FROM=envois@oueb.example
