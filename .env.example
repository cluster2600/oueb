# Copiez vers .env (gitignoré) et remplissez. Secrets : `openssl rand -hex 32`.

# --- Global ---
MAIN_DOMAIN=oueb.example                 # domaine du back-office (Twenty/n8n/Listmonk/Kanboard)
ACME_EMAIL=admin@oueb.example            # contact Let's Encrypt (back-office)

# --- PostgreSQL (n8n + listmonk + twenty + kanboard) ---
PG_USER=oueb
PG_PASSWORD=change-me-strong

# --- n8n ---
N8N_ENCRYPTION_KEY=change-me-32-bytes-hex

# --- Twenty CRM ---
TWENTY_APP_SECRET=change-me-32-bytes-hex
TWENTY_API_KEY=                          # généré dans Twenty (Settings > API), pour n8n

# --- Kanboard ---
# Base64 de "jsonrpc:<API token>" (Kanboard Basic auth). Ex :
#   printf 'jsonrpc:%s' "$TOKEN" | base64
KANBOARD_API_TOKEN=

# --- Listmonk ---
LISTMONK_API_USER=oueb
LISTMONK_ADMIN_PASSWORD=change-me
LISTMONK_API_TOKEN=                      # Base64 de "user:token" (Basic auth API)

# --- sitegen / Cloudflare Pages ---
SITEGEN_TOKEN=change-me-hex
CLOUDFLARE_API_TOKEN=...                  # scope: Pages:Edit (+ DNS si domaines sur CF)
CLOUDFLARE_ACCOUNT_ID=...

# --- LLM : endpoint NVIDIA (nvidia/nemotron-3-ultra-550b-a55b) ---
# En prod : injecté depuis OCI Vault au boot (instance principal), PAS en clair ici.
NVIDIA_API_KEY=

# --- Scraper ---
SCRAPER_TOKEN=change-me-hex
# Backend navigateur : local (Chromium dans le conteneur) | kitesurf
# (Cloudflare Browser Run, navigateur agent-first — réutilise CLOUDFLARE_API_TOKEN
# ci-dessus, qui doit alors porter aussi la permission « Browser Rendering - Edit »).
# ⚠️ Kitesurf ne négocie pas les challenges anti-bot par empreinte TLS : voir
# docs/browser-backends.md avant de basculer Google Maps dessus.
BROWSER_BACKEND=local

# --- Registrar (Gandi par défaut, couvre .ch/.li/.jp/.com) ---
GANDI_API_KEY=...
REGISTRANT_EMAIL=domains@oueb.example     # contact propriétaire des domaines achetés

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Placeholders enrichissement registre (nodes n8n désactivés) ---
HOUJIN_BANGO_APP_ID=                      # Japon (NTA, gratuit)
OPENCORPORATES_API_TOKEN=                 # USA (OpenCorporates, payant)

# --- Amazon SES (renseigné dans l'UI Listmonk, ici pour mémoire) ---
SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SES_SMTP_USER=...
SES_SMTP_PASSWORD=...
SES_FROM=envois@oueb.example
