{
	email {$ACME_EMAIL}

	# On-Demand TLS : Caddy émet un certificat Let's Encrypt à la VOLÉE pour tout
	# domaine client qui pointe vers l'IP du VPS — MAIS seulement après validation
	# par n8n (sinon n'importe qui pointant un domaine vers vous épuiserait vos
	# quotas Let's Encrypt / vous ferait signer des domaines arbitraires).
	on_demand_tls {
		ask http://n8n:5678/webhook/tls-authorize
		interval 2m
		burst 5
	}
}

# --------------------------------------------------------------------- Back-office
# Domaine principal : WordPress réseau + consoles n8n / Listmonk sous sous-chemin.
{$MAIN_DOMAIN} {
	handle_path /n8n/* {
		reverse_proxy n8n:5678
	}
	handle_path /listmonk/* {
		reverse_proxy listmonk:9000
	}
	# Endpoint scraper (protégé par token applicatif, appelé par n8n uniquement) :
	handle_path /scrape* {
		reverse_proxy scraper:8000
	}
	reverse_proxy wordpress:80 {
		header_up X-Forwarded-Proto https
	}
}

# ------------------------------------------------------------- Sites clients (On-Demand)
# Bloc "catch-all" : tout hôte HTTPS non déclaré ci-dessus. Le certificat n'est
# émis que si `ask` renvoie 200. WordPress MultiSite résout l'hôte -> bon subsite
# via sunrise.php (domaine mappé dans wp_blogs).
https:// {
	tls {
		on_demand
	}
	reverse_proxy wordpress:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}
