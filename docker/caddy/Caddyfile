	email {$ACME_EMAIL}
}

# Back-office uniquement. Les SITES CLIENTS ne passent plus par ici : ils sont
# hébergés sur Cloudflare Pages (TLS + CDN gérés par Cloudflare). Plus besoin
# d'On-Demand TLS ni de l'endpoint tls-authorize.
{$MAIN_DOMAIN} {
	handle_path /n8n/* {
		reverse_proxy n8n:5678
	}
	handle_path /listmonk/* {
		reverse_proxy listmonk:9000
	}
	handle_path /kanboard/* {
		reverse_proxy kanboard:80
	}
	# Twenty CRM à la racine (SERVER_URL = https://$MAIN_DOMAIN).
	reverse_proxy twenty:3000
}
