    {
      "parameters": {
        "jsCode": "// Country Router (+ enrichissement registre du commerce Zefix pour la Suisse).\n// Miroir de config/country_matrix.yaml + config/prompts.md.\n// Entree : item.json = reponse Zefix (peut etre vide hors CH) ; le lead d'origine\n// est lu via $('Loop leads') pour survivre a l'appel HTTP Zefix intercalaire.\nconst MATRIX = {\n  CH: { currency:'CHF', amount_minor:50000, locale:'de-CH', lang:'de_CH',\n        prompt_key:'ch_de', stripe_price_id:'price_CH_chf_500', tld:'.ch',\n        payment_methods:['card','twint'] },\n  LI: { currency:'CHF', amount_minor:50000, locale:'de-LI', lang:'de_DE',\n        prompt_key:'li_de', stripe_price_id:'price_LI_chf_500', tld:'.li',\n        payment_methods:['card','twint'] },\n  MC: { currency:'EUR', amount_minor:50000, locale:'fr-MC', lang:'fr_FR',\n        prompt_key:'mc_fr', stripe_price_id:'price_MC_eur_500', tld:'.mc',\n        payment_methods:['card'] },\n  SG: { currency:'SGD', amount_minor:50000, locale:'en-SG', lang:'en_US',\n        prompt_key:'sg_en', stripe_price_id:'price_SG_sgd_500', tld:'.sg',\n        payment_methods:['card','paynow'] },  // PayNow = SGD, QR quasi-immédiat\n  JP: { currency:'JPY', amount_minor:79800, locale:'ja-JP', lang:'ja',\n        prompt_key:'jp_keigo', stripe_price_id:'price_JP_jpy_79800', tld:'.jp',\n        payment_methods:['card','konbini'] },  // Konbini = ASYNCHRONE (voir provisioning)\n  US: { currency:'USD', amount_minor:50000, locale:'en-US', lang:'en_US',\n        prompt_key:'us_en', stripe_price_id:'price_US_usd_500', tld:'.com',\n        payment_methods:['card','link','us_bank_account'] },  // ACH = async -> gate 'paid'\n};\nconst PROMPTS = {\n  ch_de: \"Schweizer Hochdeutsch, Sie-Form, sachlich, immer 'ss' statt 'ss'. JSON only.\",\n  ch_fr: \"Francais de Suisse romande, vouvoiement, ton sobre et factuel, sans superlatifs. JSON only.\",\n  ch_it: \"Italiano della Svizzera italiana, forma di cortesia (Lei), tono sobrio e professionale. JSON only.\",\n  li_de: \"Formelles Hochdeutsch, Sie-Form, serioes/diskret (Treuhand, Family Office). JSON only.\",\n  mc_fr: \"Francais soutenu, vouvoiement, registre luxe/confidentialite. JSON only.\",\n  sg_en: \"Professional international English (British spelling), premium B2B. JSON only.\",\n  us_en: \"Professional American English (US spelling), confident and direct, credible B2B. JSON only.\",\n  jp_keigo: \"日本語の敬語で作成。丁寧語(です・ます)で統一し、相手には尊敬語、自社には謙譲語を用いる。JSONのみ返す。\",\n};\n// Cantons romands + Tessin -> langue (Fribourg bilingue: defaut fr).\nconst CANTON_LANG = { GE:'fr', VD:'fr', VS:'fr', NE:'fr', JU:'fr', FR:'fr', TI:'it' };\nconst CH_PROMPT = { de:'ch_de', fr:'ch_fr', it:'ch_it' };\nconst CH_LANG   = { de:'de_CH', fr:'fr_CH', it:'it_CH' };\n\nconst out = [];\nfor (const item of $input.all()) {\n  const lead = $('Loop leads').item.json;\n  const c = (lead.country || '').toUpperCase();\n  const m = MATRIX[c];\n  if (!m) { continue; }\n  const row = { ...lead, ...m };\n\n  // Zefix : la reponse peut etre un tableau ou { list: [...] }.\n  const z = item.json;\n  const firm = Array.isArray(z) ? z[0] : (z && z.list ? z.list[0] : null);\n  if (c === 'CH' && firm) {\n    const canton = String(firm.canton || firm.registryOfficeCanton || '').toUpperCase();\n    const l = CANTON_LANG[canton] || 'de';\n    row.prompt_key = CH_PROMPT[l];\n    row.lang = CH_LANG[l];\n    row.canton = canton || null;\n    row.uid = firm.uid || null;                    // CHE-xxx.xxx.xxx (facturation)\n    row.official_name = firm.name || lead.name;    // raison sociale officielle\n  }\n  row.name = row.official_name || lead.name;\n  row.system_prompt = PROMPTS[row.prompt_key];\n  row.slug = (row.name || '').toLowerCase().normalize('NFKD')\n               .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40);\n  row.domain_target = null;\n  out.push({ json: row });\n}\nreturn out;\n"
      },
      "id": "2660fb4d-adb4-4ea2-ad12-be5554d2716a",
      "name": "Country Router",
