          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"nvidia/nemotron-3-ultra-550b-a55b\", \"stream\": false, \"max_tokens\": 4096, \"temperature\": 0.6, \"top_p\": 0.95, \"chat_template_kwargs\": { \"enable_thinking\": false }, \"messages\": [ { \"role\": \"system\", \"content\": $json.system_prompt + \" Reply with ONLY the requested JSON, no prose, no markdown fences.\" }, { \"role\": \"user\", \"content\": \"Etablissement: \" + $json.name + \" | \" + ($json.category||\"\") + \" | \" + ($json.address||\"\") + \". Genere le JSON one-page: title, meta_description, h1, h2[], hero_subtitle, sections[{heading,body}], cta.\" } ] } }}"
      },
