{
  "name": "oueb — 2. Provisioning (Stripe webhook)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stripe",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      },
      "id": "120439f2-1423-4840-acf9-d0ab7584ddee",
      "name": "Webhook Stripe",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Vérifie la signature Stripe (HMAC SHA-256 sur le corps brut).\nconst crypto = require('crypto');\nconst secret = $env.STRIPE_WEBHOOK_SECRET;\nconst sigHeader = $json.headers['stripe-signature'] || '';\nconst raw = $json.body;                    // Webhook en mode \"raw body\"\nconst parts = Object.fromEntries(sigHeader.split(',').map(p => p.split('=')));\nconst signed = parts.t + '.' + (typeof raw === 'string' ? raw : JSON.stringify(raw));\nconst expected = crypto.createHmac('sha256', secret).update(signed).digest('hex');\nif (expected !== parts.v1) { throw new Error('Signature Stripe invalide'); }\nconst event = typeof raw === 'string' ? JSON.parse(raw) : raw;\nreturn [{ json: event }];\n"
      },
      "id": "31d75a21-0501-454f-942f-426e17fff179",
      "name": "Vérifier signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.type }}",
              "rightValue": "checkout.session.completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "00ac4d52-fece-410a-87a4-a6243a25ac9c",
      "name": "IF checkout.completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cloudflare.com/client/v4/accounts/{{ $env.CF_ACCOUNT_ID }}/registrar/domains",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CLOUDFLARE_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"name\": $json.data.object.metadata.domain_target } }}"
      },
      "id": "c9890fc5-6d3b-4397-9105-7d7c9efbf7a4",
      "name": "Cloudflare — achat domaine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.MAIN_DOMAIN }}/wp-json/oueb/v1/sites",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"template_id\": 2, \"slug\": $json.data.object.metadata.domain_target.split('.')[0], \"title\": $json.data.object.metadata.domain_target, \"domain\": $json.data.object.metadata.domain_target, \"seo\": { \"title\": $json.data.object.metadata.domain_target, \"meta_description\": \"\", \"h1\": $json.data.object.metadata.domain_target } } }}"
      },
      "id": "03a57c51-3743-4b8f-855c-f6445fdcd478",
      "name": "WP — map domaine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        220
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO client_domains(domain, blog_id, active) VALUES ($1, $2, true) ON CONFLICT (domain) DO UPDATE SET active=true",
        "options": {
          "queryReplacement": "={{ $('Webhook Stripe').item.json.body.data.object.metadata.domain_target }},{{ $json.blog_id }}"
        }
      },
      "id": "136011ec-1e56-474a-83c5-d46c158b8008",
      "name": "Postgres — client_domains",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1100,
